# Copy to apps/web/.env. See README.md for Docker and local setup.
# Browser-facing API URL; Compose also passes this as a frontend build argument.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Set true to enable your authenticated self-hosted workspace.
# false serves the public homepage and interactive sample only.
NOTEESTA_ENABLE_WORKSPACE=false
# Use http://localhost:3000 locally, or your website origin before building.
NOTEESTA_SITE_URL=https://noteesta.com
