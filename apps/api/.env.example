# FastAPI and worker settings only
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
ALLOW_DEMO_USER=true
DEMO_USER_ID=demo-user
MAX_UPLOAD_BYTES=104857600

# MongoDB metadata and chunk storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=noteesta
MONGODB_VECTOR_INDEX=vector_index

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# S3-compatible object storage (SeaweedFS defaults)
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=noteesta
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=noteesta
S3_REGION=us-east-1
S3_USE_SSL=false

# Ollama. Set OLLAMA_MODEL to the exact tag shown by `ollama list`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=32768

# Parsing and transcription
WHISPER_MODEL=small
WHISPER_DEVICE=auto
CHUNK_SIZE=1800
CHUNK_OVERLAP=180
VIDEO_FRAME_INTERVAL_SECONDS=30

# Promptfoo evals use the same Ollama settings as the backend
PROMPTFOO_CONFIG_DIR=.promptfoo
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_EVAL_TIMEOUT_MS=300000
