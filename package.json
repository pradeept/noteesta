{
  "name": "noteesta",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",    
    "format": "prettier --write apps/web/src apps/web/*.config.* apps/web/package.json apps/web/tsconfig.json",
    "format:check": "prettier --check apps/web/src apps/web/*.config.* apps/web/package.json apps/web/tsconfig.json",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
